{
  "$schema": "https://vega.github.io/schema/vega/v6.json",
  "description": "A basic line chart example.",
  "title": {"text": "Climate Trends from 2014-2020", "anchor": "start", "fontSize": 18, "font": "Gill Sans", "offset": 30},
  "width": 690,
  "height": 200,
  "padding": 0,
  "signals": [
    {
      "name": "select_state",
      "value": "NSW",
      "bind": {
        "input": "select",
        "options": ["NSW", "NT", "VIC", "WA", "QLD", "SA", "TAS"],
        "name": "Select State "
      }
    },
    {
      "name": "select_metric1",
      "value": "Temperature Anomaly (°C)",
      "bind": {
        "input": "select",
        "options": [
          "Temperature Anomaly (°C)",
          "Rainfall Anomaly (mm)",
          "Solar Radiation Anomaly (MJ/m²)",
          "Windspeed Anomaly (m/s)"
        ],
        "name": "Select Metric 1 "
      }
    },
    {
      "name": "select_metric2",
      "value": "Rainfall Anomaly (mm)",
      "bind": {
        "input": "select",
        "options": [
          "Temperature Anomaly (°C)",
          "Rainfall Anomaly (mm)",
          "Solar Radiation Anomaly (MJ/m²)",
          "Windspeed Anomaly (m/s)"
        ],
        "name": "Select Metric 2 "
      }
    },
    { "name": "black_summer_start", "update": "timeParse('2019-09','%Y-%m')" },
    { "name": "black_summer_end",   "update": "timeParse('2020-02','%Y-%m')" }
  ],
  "data": [
    {
      "name": "table",
      "url": "https://raw.githubusercontent.com/hieuductrinh/black_summer_australia_data_visualisation/refs/heads/main/data/climate_anomalies_lowess.csv",
      "format": {
        "type": "csv",
        "parse": {"month": "date:'%Y-%m'"},
        "delimiter": ","
      },
      "transform": [{"type": "filter", "expr": "datum.state == select_state"}]
    }
  ],
  "scales": [
    {
      "name": "x",
      "type": "time",
      "range": "width",
      "domain": {"data": "table", "field": "month"}
    },
    {
      "name": "y1",
      "type": "linear",
      "range": "height",
      "nice": true,
      "zero": true,
      "domain": {"data": "table", "field": {"signal": "select_metric1"}}
    },
    {
      "name": "y2",
      "type": "linear",
      "range": "height",
      "nice": true,
      "zero": true,
      "domain": {"data": "table", "field": {"signal": "select_metric2"}}
    }
  ],
  "axes": [
    {"orient": "bottom", "scale": "x", "title": "Month", "titleFont": "Gill Sans", "labelFont": "Gill Sans"},
    {"orient": "left", "scale": "y1", "title": {"signal": "select_metric1"}, "titleFont": "Gill Sans", "labelFont": "Gill Sans", "titleColor": "#5676a4", "minExtent": 50},
    {"orient": "right", "scale": "y2", "title": {"signal": "select_metric2"}, "titleFont": "Gill Sans", "labelFont": "Gill Sans", "titleColor": "#d98f4a", "minExtent": 50}
  ],
  "marks": [
    {
      "type": "line",
      "from": {"data": "table"},
      "sort": {"field": "month", "order": "ascending"},
      "encode": {
        "enter": {"strokeWidth": {"value": 2}, "stroke": {"value": "#5676a4"}},
        "update": {
          "x": {"scale": "x", "field": "month"},
          "y": {"scale": "y1", "field": {"signal": "select_metric1"}},
          "state": {"signal": "select_state"},
          "strokeOpacity": {"value": 1}
        }
      }
    },
    {
      "type": "symbol",
      "from": {"data": "table"},
      "sort": {"field": "month", "order": "ascending"},
      "encode": {
        "enter": {"size": {"value": 30}, "fill": {"value": "#5676a4"}},
        "update": {
          "x": {"scale": "x", "field": "month"},
          "y": {"scale": "y1", "field": {"signal": "select_metric1"}},
          "state": {"signal": "select_state"},
          "strokeOpacity": {"value": 1},
          "tooltip": {
            "signal": "{'Month': timeFormat(datum.month,'%Y-%m'), 'Metric': select_metric1, 'Value': format(datum[select_metric1], '.2f')}"
          }
        }
      }
    },
    {
      "type": "line",
      "from": {"data": "table"},
      "sort": {"field": "month", "order": "ascending"},
      "encode": {
        "enter": {"strokeWidth": {"value": 2}, "stroke": {"value": "#d98f4a"}},
        "update": {
          "x": {"scale": "x", "field": "month"},
          "y": {"scale": "y2", "field": {"signal": "select_metric2"}},
          "state": {"signal": "select_state"},
          "strokeOpacity": {"value": 1}
        }
      }
    },
    {
      "type": "symbol",
      "from": {"data": "table"},
      "sort": {"field": "month", "order": "ascending"},
      "encode": {
        "enter": {"size": {"value": 30}, "fill": {"value": "#d98f4a"}},
        "update": {
          "x": {"scale": "x", "field": "month"},
          "y": {"scale": "y2", "field": {"signal": "select_metric2"}},
          "state": {"signal": "select_state"},
          "strokeOpacity": {"value": 1},
          "tooltip": {
            "signal": "{'Month': timeFormat(datum.month,'%Y-%m'), 'Metric': select_metric2, 'Value': format(datum[select_metric2], '.2f')}"
          }
        }
      }
    }
  ],
  "config": {
    "font": "Gill Sans",
    "axis": {
      "titleFontSize": 13,
      "labelFontSize": 13
    }
  }
}